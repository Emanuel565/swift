{
  "manifest_version": 3,
  "name": "Radiante Ghost Audio v3",
  "version": "1.0.0",
  "description": "Captura de áudio do Google Meet + transcrição ao vivo para o Ghost Engine v3.",
  "permissions": ["offscreen", "tabCapture", "storage", "activeTab", "tabs", "notifications"],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "ws://127.0.0.1:3000/*",
    "ws://localhost:3000/*",
    "https://meet.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content-meet.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Ghost Audio v3",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
