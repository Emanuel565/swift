PORT=3000

# Ghost Audio
GHOST_AUDIO_MAX_SESSIONS=4
GHOST_AUDIO_MAX_WS=8

# Opcional: caminho customizado para o SQLite local
# SQLITE_DB_PATH=./radiante.db

# Opcional: emite parciais de debug "[ghost-audio] ingestão: N chunks..."
# GHOST_AUDIO_EMIT_INGEST_DEBUG=false

# Opcional: endpoint HTTP externo para STT. Recebe application/octet-stream.
# GHOST_AUDIO_STT_URL=http://localhost:9000/stt

# Whisper local
WHISPER_ENABLED=true
WHISPER_MODEL=Xenova/whisper-small
WHISPER_LANG=portuguese
WHISPER_TASK=transcribe

# Opcional: habilita auth por token no /ws/audio
# JWT_SECRET=troque-em-producao